# Server Port
PORT=5000

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/zemo

# Gemini AI Key for intelligent price comparison, bank offers & review synthesis
GEMINI_API_KEY=your_gemini_api_key_here

# HuggingFace API Key for aspect analysis
HF_API_KEY=your_huggingface_api_key_here

# SMTP / Email Alerts Configuration
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
NOTIFICATION_EMAIL=your_email@gmail.com

# Optional Email Deliverability Validation
ABSTRACT_EMAIL_API_KEY=your_abstract_api_key_here
